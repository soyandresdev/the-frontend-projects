---
import { getLang, useTranslatedPath, useTranslations } from '../i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

// Misma página en el otro idioma
const basePath = Astro.url.pathname.replace(/^\/es(\/|$)/, '/')
const hrefEn = basePath
const hrefEs = `/es${basePath === '/' ? '/' : basePath}`
---

<!-- Nav mínimo: logo en la esquina, idiomas y GitHub. Se esconde al bajar y vuelve al subir. -->
<header
  data-nav
  class="pointer-events-none fixed inset-x-0 top-0 z-50 flex items-center justify-between px-4 pt-4 transition-transform duration-500 ease-[var(--ease-out-expo)] md:px-6 md:pt-5 [&.nav-hidden]:-translate-y-[130%]"
>
  <a
    href={translatePath('/')}
    aria-label="The Front-End Projects"
    data-magnetic="0.2"
    class="glass pointer-events-auto grid h-12 w-12 place-items-center rounded-full transition-[transform,background-color] duration-200 ease-[var(--ease-out-expo)] hover:bg-white/10 active:scale-[0.97]"
  >
    <img src="/logo.svg" alt="" width="26" height="26" class="h-[26px] w-[26px]" />
  </a>

  <nav class="glass pointer-events-auto flex items-center gap-1 rounded-full p-1" aria-label="Main">
    <div class="flex items-center font-mono text-[11px] font-medium tracking-wider">
      <a
        href={hrefEn}
        aria-current={lang === 'en' ? 'page' : undefined}
        class={`rounded-full px-3 py-2 transition-colors ${lang === 'en' ? 'bg-white/15 text-white' : 'text-white/50 hover:text-white'}`}
      >
        EN
      </a>
      <a
        href={hrefEs}
        aria-current={lang === 'es' ? 'page' : undefined}
        class={`rounded-full px-3 py-2 transition-colors ${lang === 'es' ? 'bg-white/15 text-white' : 'text-white/50 hover:text-white'}`}
      >
        ES
      </a>
    </div>
    <a
      href="https://github.com/soyandresdev/the-frontend-projects"
      target="_blank"
      rel="noreferrer"
      aria-label={t('nav.github')}
      data-magnetic="0.25"
      class="text-ink hover:bg-brand-lime grid h-9 w-9 place-items-center rounded-full bg-white transition-[transform,background-color] duration-200 ease-[var(--ease-out-expo)] active:scale-[0.97]"
    >
      <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
  </nav>
</header>
