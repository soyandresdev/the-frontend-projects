---
import { PROJECTS } from '../consts'
import { getLang, useTranslatedPath, useTranslations } from '../i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const total = PROJECTS.filter((p) => !p.hidden).length

// Misma página en el otro idioma
const basePath = Astro.url.pathname.replace(/^\/es(\/|$)/, '/')
const hrefEn = basePath
const hrefEs = `/es${basePath === '/' ? '/' : basePath}`
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 flex justify-center px-3 pt-3 transition-transform duration-500 ease-[var(--ease-out-expo)] md:px-6 md:pt-5 [&.nav-hidden]:-translate-y-[130%]"
>
  <nav
    class="glass flex w-full max-w-6xl items-center justify-between gap-3 rounded-full py-1.5 pr-1.5 pl-2"
    aria-label="Main"
  >
    <a href={translatePath('/')} class="flex items-center gap-2.5 rounded-full py-1 pr-3 pl-1">
      <img src="/logo.svg" alt="" width="30" height="30" class="h-7 w-7" />
      <span class="font-display hidden text-sm font-semibold tracking-tight sm:inline">
        The Front-End Projects
      </span>
    </a>

    <div
      class="hidden items-center gap-1 font-mono text-[11px] tracking-[0.18em] uppercase md:flex"
    >
      <a
        href={translatePath('/') + '#projects'}
        class="rounded-full px-3 py-1.5 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
      >
        {t('nav.projects')}
        <span class="ml-1 text-white/35">{total}</span>
      </a>
      <a
        href={translatePath('/') + '#about'}
        class="rounded-full px-3 py-1.5 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
      >
        {t('nav.about')}
      </a>
    </div>

    <div class="flex items-center gap-1.5">
      <div
        class="flex items-center rounded-full border border-white/10 p-0.5 font-mono text-[11px] font-medium tracking-wider"
      >
        <a
          href={hrefEn}
          aria-current={lang === 'en' ? 'page' : undefined}
          class={`rounded-full px-2.5 py-1 transition-colors ${lang === 'en' ? 'bg-white/15 text-white' : 'text-white/50 hover:text-white'}`}
        >
          EN
        </a>
        <a
          href={hrefEs}
          aria-current={lang === 'es' ? 'page' : undefined}
          class={`rounded-full px-2.5 py-1 transition-colors ${lang === 'es' ? 'bg-white/15 text-white' : 'text-white/50 hover:text-white'}`}
        >
          ES
        </a>
      </div>
      <a
        href="https://github.com/soyandresdev/the-frontend-projects"
        target="_blank"
        rel="noreferrer"
        data-magnetic="0.25"
        class="text-ink hover:bg-brand-lime flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold transition-[transform,background-color] duration-200 ease-[var(--ease-out-expo)] active:scale-[0.97]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span class="hidden sm:inline">{t('nav.github')}</span>
      </a>
    </div>
  </nav>
</header>
