---
/*
  Hero.astro
  ==========
  Intro editorial afín al hero original: "The" gigante con degradado,
  "Front-End Projects" debajo, bio con contador y foto grande con "By Andres".
  Se anima al cargar (no espera scroll).
*/
import { PROJECTS } from '../consts'
import { getLang, useTranslations } from '../i18n/utils'
import PhotoStack from './PhotoStack.astro'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const visible = PROJECTS.filter((p) => !p.hidden)
const total = visible.length
const big = String(total).padStart(2, '0')

// Tags únicos para el marquee, por frecuencia
const freq = new Map<string, number>()
visible.forEach((p) => p.tags.forEach((tag) => freq.set(tag, (freq.get(tag) ?? 0) + 1)))
const marquee = [...freq.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag)
  .slice(0, 24)
---

<section
  id="about"
  class="relative mx-auto flex min-h-[100svh] w-full max-w-7xl flex-col justify-center px-6 pt-28 pb-20 md:px-10"
>
  <!-- eyebrow -->
  <p
    data-reveal="hero"
    class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.22em] text-white/60 uppercase"
  >
    <span class="inline-flex items-center gap-2">
      <span class="bg-brand-lime h-2 w-2 animate-[var(--animate-pulse-dot)] rounded-full"></span>
      {t('hero.available')}
    </span>
    <span class="text-white/25">/</span>
    <span>{t('hero.eyebrow')}</span>
    <span class="text-white/25">/</span>
    <span>{total} {t('nav.projectsLabel')}</span>
  </p>

  <!-- título: "The" gigante con degradado + "Front-End Projects" -->
  <h1
    class="split-mask font-display mt-2 flex flex-col items-center text-center font-bold drop-shadow-[0_6px_18px_rgba(0,0,0,0.45)]"
  >
    <span class="block overflow-clip px-[0.16em] pt-[0.04em] pb-[0.08em]">
      <span
        class="text-gradient block text-[clamp(6.5rem,22vw,17.5rem)] leading-[0.9] tracking-[-0.045em]"
        data-line>The</span
      >
    </span>
    <span
      class="mt-1 block text-[clamp(2rem,6.2vw,5.5rem)] leading-[1] tracking-[-0.035em] text-white"
      data-split>Front-End Projects</span
    >
  </h1>

  <div class="mt-10 grid items-center gap-12 md:mt-12 md:grid-cols-[1.2fr_auto] md:gap-16">
    <!-- texto (bloque de bio original: saludo en degradado, chips de color, ubicación) -->
    <div class="mx-auto max-w-xl text-center md:mx-0 md:text-left">
      <h2
        data-reveal="hero"
        class="text-2xl drop-shadow-[0_3px_6px_rgba(0,0,0,0.6)] md:text-[1.7rem]"
      >
        <span
          class="bg-gradient-to-r from-[rgb(var(--clr-lime))] to-[rgb(var(--clr-cyan))] bg-clip-text text-transparent transition-colors hover:from-[rgb(var(--clr-cyan))] hover:to-[rgb(var(--clr-lime))]"
          >{t('hero.greeting')}</span
        ><span> 👋</span>
      </h2>
      <p data-reveal="hero" class="mt-4 leading-relaxed text-slate-200/90">
        {t('hero.bio.part1')}
        <strong class="rounded-sm bg-yellow-100 px-1.5 py-0.5 text-yellow-800"
          >{t('hero.bio.frontend')}</strong
        >
        {t('hero.bio.part2')}
        <strong class="rounded-sm bg-[rgb(243,115,33)] px-2 py-0.5 text-slate-900">HTML</strong>,
        <strong class="rounded-sm bg-[rgb(22,118,188)] px-2 py-0.5 text-white">CSS</strong>
        {t('hero.bio.and')}
        <strong class="rounded-sm bg-[rgb(247,223,30)] px-2 py-0.5 text-slate-900"
          >JavaScript</strong
        >
        {t('hero.bio.part3')}
      </p>
      <p
        data-reveal="hero"
        class="mt-4 flex items-center justify-center gap-1.5 drop-shadow-[0_3px_6px_rgba(0,0,0,0.6)] md:justify-start"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 12.75C13.6569 12.75 15 11.4069 15 9.75C15 8.09315 13.6569 6.75 12 6.75C10.3431 6.75 9 8.09315 9 9.75C9 11.4069 10.3431 12.75 12 12.75Z"
            stroke="url(#pin-a)"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M19.5 9.75C19.5 16.5 12 21.75 12 21.75C12 21.75 4.5 16.5 4.5 9.75C4.5 7.76088 5.29018 5.85322 6.6967 4.4467C8.10322 3.04018 10.0109 2.25 12 2.25C13.9891 2.25 15.8968 3.04018 17.3033 4.4467C18.7098 5.85322 19.5 7.76088 19.5 9.75Z"
            stroke="url(#pin-b)"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <defs>
            <linearGradient
              id="pin-a"
              x1="12"
              y1="6.75"
              x2="12"
              y2="12.75"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#00F3FF"></stop><stop offset="1" stop-color="#87F113"></stop>
            </linearGradient>
            <linearGradient
              id="pin-b"
              x1="12"
              y1="2.25"
              x2="12"
              y2="21.75"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#00F3FF"></stop><stop offset="1" stop-color="#87F113"></stop>
            </linearGradient>
          </defs>
        </svg>
        <span
          class="bg-gradient-to-r from-[rgb(var(--clr-lime))] to-[rgb(var(--clr-cyan))] bg-clip-text text-transparent"
        >
          {t('hero.locationLong')}
        </span>
      </p>
      <!-- contador -->
      <div data-reveal="hero" class="mt-8 flex items-end justify-center gap-4 md:justify-start">
        <span
          class="font-display text-outline text-[4.5rem] leading-none font-bold tracking-tighter tabular-nums md:text-[5.5rem]"
          data-counter={total}
          aria-label={`${total} ${t('hero.counterLabel')}`}>{big}</span
        >
        <span
          class="mb-2 max-w-[9rem] text-left font-mono text-[11px] leading-relaxed tracking-[0.2em] text-white/50 uppercase"
        >
          {t('hero.counterLabel')}
        </span>
      </div>
    </div>

    <!-- foto con "By Andres" -->
    <div data-reveal="hero" class="relative mx-auto mt-6 pt-16 md:mx-0 md:mt-0 md:pr-10">
      <div data-tilt class="relative [transform-style:preserve-3d]">
        <PhotoStack />
        <span
          aria-hidden="true"
          class="font-display pointer-events-none absolute -top-11 left-1/2 [transform:translateX(-50%)_translateZ(40px)] text-[5.5rem] leading-none font-extrabold tracking-tighter whitespace-nowrap text-white drop-shadow-[0_6px_18px_rgba(0,0,0,0.6)] select-none md:-top-14 md:text-[7rem]"
        >
          <span class="absolute -top-[0.55em] -left-[0.1em] text-[0.45em] tracking-tight">By</span>
          Andres
        </span>
      </div>
    </div>
  </div>

  <!-- marquee de tecnologías -->
  <div data-reveal="hero" class="marquee mt-14 overflow-hidden border-y border-white/10 py-3.5">
    <div
      class="marquee-track flex w-max gap-8 font-mono text-[11px] tracking-[0.22em] text-white/50 uppercase"
    >
      {
        [...marquee, ...marquee].map((tag) => (
          <span class="flex items-center gap-8">
            {tag}
            <span class="text-brand-lime" aria-hidden="true">
              ✦
            </span>
          </span>
        ))
      }
    </div>
  </div>

  <!-- scroll hint -->
  <a
    href="#projects"
    data-reveal="hero"
    class="absolute bottom-7 left-6 flex items-center gap-3 font-mono text-[10px] tracking-[0.25em] text-white/40 uppercase transition-colors hover:text-white md:left-10"
  >
    <span class="block h-9 w-px origin-top animate-[var(--animate-scroll-line)] bg-white/50"></span>
    {t('hero.scroll')}
  </a>
</section>
