---
import { getLang, useTranslations } from '../i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const year = new Date().getFullYear()
---

<footer class="relative mx-auto w-full max-w-7xl px-6 pb-8 md:px-10">
  <!-- CTA -->
  <div
    data-reveal
    class="relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br from-white/[0.07] to-transparent p-8 md:p-14"
  >
    <div
      aria-hidden="true"
      class="bg-brand-cyan/20 pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="bg-brand-lime/15 pointer-events-none absolute -bottom-32 -left-16 h-72 w-72 rounded-full blur-3xl"
    >
    </div>
    <p class="font-mono text-[11px] tracking-[0.22em] text-white/50 uppercase">Next</p>
    <h2
      class="font-display mt-3 max-w-3xl text-4xl leading-[1.02] font-bold tracking-tight md:text-6xl"
    >
      {t('footer.cta')}
    </h2>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="https://soyandres.dev"
        target="_blank"
        rel="noreferrer"
        data-magnetic="0.25"
        class="text-ink hover:bg-brand-lime inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold transition-[transform,background-color] duration-200 ease-[var(--ease-out-expo)] active:scale-[0.97]"
      >
        {t('footer.ctaBtn')}
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        href="https://github.com/soyandresdev/the-frontend-projects"
        target="_blank"
        rel="noreferrer"
        data-magnetic="0.25"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 text-sm font-medium text-white/85 transition-[transform,border-color,background-color] duration-200 ease-[var(--ease-out-expo)] hover:border-white/40 hover:bg-white/5 active:scale-[0.97]"
      >
        GitHub
      </a>
    </div>
  </div>

  <!-- pie -->
  <div
    class="mt-10 flex flex-col gap-6 border-t border-white/10 pt-8 md:flex-row md:items-center md:justify-between"
  >
    <a href="https://soyandres.dev" title="SoyAndresDev" class="flex items-center gap-2.5">
      <img src="/logo.svg" alt="" width="28" height="28" class="h-7 w-7" loading="lazy" />
      <span class="font-display text-sm font-semibold tracking-tight">SoyAndresDev</span>
    </a>

    <div class="flex items-center gap-2">
      <a
        href="https://twitter.com/soyandresdev"
        target="_blank"
        rel="noreferrer"
        aria-label="X / Twitter"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/10 text-white/70 transition-colors hover:border-white/40 hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M18.244 2H21l-6.52 7.45L22 22h-6.828l-4.77-6.23L4.9 22H2.14l6.97-7.97L2 2h6.914l4.32 5.71L18.244 2Zm-1.2 18h1.83L7.03 3.9H5.07L17.044 20Z"
          ></path>
        </svg>
      </a>
      <a
        href="https://github.com/soyandresdev"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/10 text-white/70 transition-colors hover:border-white/40 hover:text-white"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>

    <p class="font-mono text-xs text-white/45">{t('footer.madeWith')} · © {year}</p>

    <a
      href="#top"
      data-magnetic="0.3"
      class="inline-flex items-center gap-2 self-start rounded-full border border-white/10 px-4 py-2 font-mono text-[11px] tracking-[0.18em] text-white/70 uppercase transition-colors hover:border-white/40 hover:text-white md:self-auto"
    >
      {t('footer.top')}
      <svg
        viewBox="0 0 24 24"
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5m-7 7 7-7 7 7"></path>
      </svg>
    </a>
  </div>
</footer>
