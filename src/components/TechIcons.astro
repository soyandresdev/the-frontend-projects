---
/*
  TechIcons.astro
  ===============
  Fila de logos de las tecnologías de un proyecto (ver utils/tech.ts).
  Los SVG viven en public/tech y vienen de svgporn.com.
*/
import { splitTags } from '../utils/tech'

interface Props {
  tags: string[]
  size?: 'sm' | 'md'
  class?: string
}
const { tags, size = 'sm', class: className = '' } = Astro.props
const { tech } = splitTags(tags)
const h = size === 'sm' ? 'h-4' : 'h-6'
const gap = size === 'sm' ? 'gap-2.5' : 'gap-3.5'
---

{
  tech.length > 0 && (
    <ul class={`flex items-center ${gap} ${className}`} aria-label="Tech stack">
      {tech.map((t) => (
        <li class="flex items-center">
          <img
            src={`/tech/${t.file}.svg`}
            alt={t.label}
            title={t.label}
            loading="lazy"
            decoding="async"
            draggable="false"
            class={`${h} w-auto ${t.wide ? '' : 'aspect-square'} object-contain transition-transform duration-300 ease-[var(--ease-out-expo)] hover:scale-110`}
          />
        </li>
      ))}
    </ul>
  )
}
