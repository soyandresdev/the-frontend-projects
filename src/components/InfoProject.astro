---
import type { Difficulty } from '../consts'

const { info } = Astro.props

const DIFFICULTY_LABEL: Record<Difficulty, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced'
}

const DIFFICULTY_CLASS: Record<Difficulty, string> = {
  beginner: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300',
  intermediate: 'border-amber-400/30 bg-amber-400/10 text-amber-300',
  advanced: 'border-rose-400/30 bg-rose-400/10 text-rose-300'
}
---

<!-- Panel informativo al estilo del sitio -->
<div
  class="absolute bottom-8 left-8 hidden flex-col items-start space-y-3 rounded-2xl bg-white/10 p-5 shadow-xl backdrop-blur-md sm:flex dark:bg-black/20"
>
  <!-- Número de proyecto grande con gradiente -->
  <div
    class="bg-[linear-gradient(90deg,rgb(var(--clr-cyan)),rgb(var(--clr-lime)))] bg-clip-text text-5xl font-extrabold text-transparent sm:text-6xl"
  >
    #{info.number}
  </div>

  <!-- Título del proyecto -->
  <h2 class="text-lg font-semibold text-white drop-shadow-md sm:text-2xl">
    {info.title}
  </h2>

  <!-- Badge de dificultad -->
  <span
    class={`rounded-full border px-2 py-1 text-[11px] font-semibold tracking-wide uppercase backdrop-blur-md ${DIFFICULTY_CLASS[info.difficulty as Difficulty]}`}
  >
    {DIFFICULTY_LABEL[info.difficulty as Difficulty]}
  </span>

  <!-- Enlace para volver a la lista de proyectos -->
  <a
    href="/"
    class="mt-2 inline-block rounded-lg bg-[rgb(var(--clr-cyan))] px-4 py-1 font-medium text-black transition hover:bg-[rgb(var(--clr-cyan))]/80 dark:bg-[rgb(var(--clr-lime))] dark:hover:bg-[rgb(var(--clr-lime))]/80"
  >
    ← Volver a proyectos
  </a>
</div>
