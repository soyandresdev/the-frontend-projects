---
import { PROJECTS } from '../consts'
import { getLang, useTranslations } from '../i18n/utils'
import Filters from './Filters.astro'
import ProjectCard from './ProjectCard.astro'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

// Numeramos según el orden real de creación (posición en PROJECTS) ANTES de mezclar,
// así el badge #NN no se ve afectado por el orden visual.
const numbered = PROJECTS.filter((p) => !p.hidden).map((p, i) => ({
  ...p,
  num: String(i + 1).padStart(2, '0')
}))
const total = numbered.length

// Hash simple y estable por slug: orden "mezclado" que no agrupa por dificultad
// pero es idéntico en cada build.
function hashSlug(slug: string) {
  let hash = 0
  for (let i = 0; i < slug.length; i++) {
    hash = (hash << 5) - hash + slug.charCodeAt(i)
    hash |= 0
  }
  return hash
}
const cards = numbered.slice().sort((a, b) => hashSlug(a.slug) - hashSlug(b.slug))

// Chips de tecnología: tags presentes en 2+ proyectos, excluyendo los universales.
const freq = new Map<string, number>()
numbered.forEach((p) => p.tags.forEach((tag) => freq.set(tag, (freq.get(tag) ?? 0) + 1)))
const tagChips = [...freq.entries()]
  .filter(([tag, n]) => n >= 2 && !['HTML', 'CSS', 'JavaScript'].includes(tag))
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag)
  .slice(0, 10)
---

<section id="projects" class="relative mx-auto w-full max-w-7xl scroll-mt-24 px-6 pb-28 md:px-10">
  <div data-reveal class="mb-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-[11px] tracking-[0.22em] text-white/50 uppercase">
        ({String(total).padStart(2, '0')})
      </p>
      <h2 class="font-display mt-3 text-4xl font-bold tracking-tight md:text-6xl">
        {t('projects.heading')}
      </h2>
      <p class="mt-3 max-w-md text-white/60">{t('projects.sub')}</p>
    </div>
    <p class="font-mono text-sm text-white/50 tabular-nums" aria-live="polite">
      <span data-count class="text-white">{total}</span> / {total}
      {t('filter.results')}
    </p>
  </div>

  <div data-reveal>
    <Filters tags={tagChips} />
  </div>

  <div
    data-grid
    data-reveal-group
    class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      cards.map((p) => (
        <ProjectCard project={p} num={p.num} featured={p.difficulty === 'advanced'} />
      ))
    }
  </div>

  <p
    data-empty
    class="hidden rounded-[28px] border border-dashed border-white/15 px-6 py-16 text-center text-white/60"
  >
    {t('filter.empty')}
  </p>
</section>
