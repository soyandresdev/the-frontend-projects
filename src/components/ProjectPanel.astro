---
/*
  ProjectPanel.astro
  ==================
  Panel flotante de la página de detalle: número, título, stack, dificultad,
  temas, acciones y navegación anterior/siguiente. Toma el color de acento del
  proyecto (calculado desde su screenshot) para el borde, el número y el botón
  principal. Se puede plegar para ver el demo entero.
*/
import type { Difficulty, Project } from '../consts'
import { getLang, getLocalized, useTranslatedPath, useTranslations } from '../i18n/utils'
import { getAccent } from '../utils/color'
import { splitTags } from '../utils/tech'
import Button from './Button.astro'
import TechIcons from './TechIcons.astro'

interface Props {
  project: Project
  number: string
  total: number
  prev?: { slug: string; title: string } | null
  next?: { slug: string; title: string } | null
}
const { project: p, number, total, prev = null, next = null } = Astro.props

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const title = getLocalized(p.title, lang)
const description = getLocalized(p.description, lang)
const accent = await getAccent(p.slug)
const { topics } = splitTags(p.tags)
const visibleTopics = topics.slice(0, 4)

const DIFFICULTY_LABEL: Record<Difficulty, string> = {
  beginner: t('difficulty.beginner'),
  intermediate: t('difficulty.intermediate'),
  advanced: t('difficulty.advanced')
}
const DIFFICULTY_CLASS: Record<Difficulty, string> = {
  beginner: 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300',
  intermediate: 'border-amber-400/40 bg-amber-400/10 text-amber-300',
  advanced: 'border-rose-400/40 bg-rose-400/10 text-rose-300'
}
---

<div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-start p-3 md:p-6">
  <aside
    data-panel
    style={`--glow: ${accent.color}; --glow-ink: ${accent.ink}`}
    class="panel pointer-events-auto relative w-full max-w-md overflow-hidden rounded-[28px] p-5 shadow-2xl transition-transform duration-500 ease-[var(--ease-out-expo)] [&.is-collapsed]:translate-y-[calc(100%-3.25rem)]"
  >
    <!-- acento: línea superior + halo de color del proyecto -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,var(--glow),transparent_75%)]"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-28 -left-20 h-64 w-64 rounded-full bg-[var(--glow)] opacity-[0.18] blur-3xl"
    ></span>

    <!-- cabecera (siempre visible) -->
    <div class="relative flex h-7 items-center justify-between gap-3">
      <a
        href={translatePath('/') + '#projects'}
        aria-label={t('project.back')}
        class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] whitespace-nowrap text-white/60 uppercase transition-colors hover:text-white"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5m7 7-7-7 7-7"></path>
        </svg>
        <span class="hidden sm:inline">{t('project.back')}</span>
      </a>
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-[11px] tracking-wider whitespace-nowrap tabular-nums">
          <span class="text-[var(--glow)]">#{number}</span>
          <span class="hidden text-white/30 sm:inline">/ {String(total).padStart(2, '0')}</span>
        </span>
        <button
          type="button"
          data-panel-toggle
          data-label-show={t('project.show')}
          data-label-hide={t('project.hide')}
          aria-expanded="true"
          class="rounded-full border border-white/15 px-3 py-1 font-mono text-[10px] tracking-[0.18em] whitespace-nowrap text-white/70 uppercase transition-colors hover:border-[var(--glow)] hover:text-white"
        >
          <span>{t('project.hide')}</span>
        </button>
      </div>
    </div>

    <h1
      class="font-display relative mt-3 text-xl leading-tight font-semibold tracking-tight sm:text-2xl"
      transition:name={`title-${p.slug}`}
    >
      {title}
    </h1>
    <p class="relative mt-2 line-clamp-2 text-sm leading-relaxed text-white/60">{description}</p>

    <!-- stack + dificultad -->
    <div class="relative mt-4 flex items-center justify-between gap-3">
      <TechIcons tags={p.tags} size="md" />
      <span
        class={`shrink-0 rounded-full border px-2.5 py-1 font-mono text-[10px] tracking-wider uppercase ${DIFFICULTY_CLASS[p.difficulty]}`}
      >
        {DIFFICULTY_LABEL[p.difficulty]}
      </span>
    </div>

    {
      visibleTopics.length > 0 && (
        <ul class="relative mt-3 hidden flex-wrap gap-1.5 font-mono text-[10px] tracking-wider text-white/55 uppercase sm:flex">
          {visibleTopics.map((tag) => (
            <li class="rounded-full border border-white/10 px-2 py-1">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="relative mt-4 flex flex-wrap gap-2">
      <Button
        href={p.links.homepage || `/demo/${p.slug}/index.html`}
        label={t('project.open')}
        variant="accent"
      />
      <Button
        href={`https://github.com/soyandresdev/the-frontend-projects/tree/main/workspace/${p.slug}`}
        label={t('project.code')}
        variant="code"
      />
      {
        p.links.youtube && (
          <Button href={p.links.youtube} label={t('project.video')} variant="video" />
        )
      }
    </div>

    <nav
      class="relative mt-4 grid grid-cols-2 gap-4 border-t border-white/10 pt-3"
      aria-label="Project navigation"
    >
      {
        prev ? (
          <a
            href={translatePath(`/projects/${prev.slug}`)}
            class="group/nav flex min-w-0 flex-col gap-0.5 transition-colors"
          >
            <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-[0.18em] text-white/45 uppercase transition-colors group-hover/nav:text-[var(--glow)]">
              <span class="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover/nav:-translate-x-0.5">
                ←
              </span>
              {t('project.prev')}
            </span>
            <span class="truncate text-[13px] text-white/80 transition-colors group-hover/nav:text-white">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={translatePath(`/projects/${next.slug}`)}
            class="group/nav flex min-w-0 flex-col items-end gap-0.5 text-right transition-colors"
          >
            <span class="flex items-center gap-1.5 font-mono text-[10px] tracking-[0.18em] text-white/45 uppercase transition-colors group-hover/nav:text-[var(--glow)]">
              {t('project.next')}
              <span class="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover/nav:translate-x-0.5">
                →
              </span>
            </span>
            <span class="w-full truncate text-[13px] text-white/80 transition-colors group-hover/nav:text-white">
              {next.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </aside>
</div>
