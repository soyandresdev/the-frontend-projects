---
import AmbientBackground from '../../components/AmbientBackground.astro'
import Nav from '../../components/Nav.astro'
import Layout from '../../layouts/Layout.astro'
import { getLang, useTranslatedPath, useTranslations } from '../../i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<Layout title="404">
  <div
    class="relative min-h-screen overflow-hidden bg-[linear-gradient(40deg,rgb(var(--bg-dark)),rgb(var(--bg-light)))]"
  >
    <AmbientBackground />
    <Nav />
    <main
      class="relative z-10 mx-auto flex min-h-screen max-w-4xl flex-col items-center justify-center px-6 text-center"
    >
      <p data-reveal="hero" class="font-mono text-[11px] tracking-[0.22em] text-white/50 uppercase">
        Error
      </p>
      <h1
        class="split-mask font-display text-gradient mt-4 text-[clamp(6rem,28vw,18rem)] leading-none font-bold tracking-[-0.06em]"
      >
        <span data-split>404</span>
      </h1>
      <p data-reveal="hero" class="mt-4 max-w-md text-lg text-white/70">{t('404.message')}</p>
      <a
        href={translatePath('/')}
        data-reveal="hero"
        data-magnetic="0.25"
        class="text-ink hover:bg-brand-lime mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold transition-[transform,background-color] duration-200 ease-[var(--ease-out-expo)] active:scale-[0.97]"
      >
        ← {t('404.back')}
      </a>
    </main>
  </div>
</Layout>
