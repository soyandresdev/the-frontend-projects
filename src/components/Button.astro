---
interface Props {
  href: string
  label: string
  variant?: 'code' | 'demo' | 'video' | 'ghost'
  size?: 'sm' | 'md'
  class?: string
}

const { href, label, variant = 'ghost', size = 'sm', class: className = '' } = Astro.props
const external = /^https?:\/\//.test(href)

const base =
  'group/btn inline-flex items-center gap-2 rounded-full font-medium whitespace-nowrap transition-[transform,background-color,border-color,color] duration-200 ease-[var(--ease-out-expo)] active:scale-[0.97]'
const sizes = { sm: 'px-3.5 py-2 text-[13px]', md: 'px-5 py-3 text-sm' }
const variants = {
  demo: 'bg-white text-ink hover:bg-brand-lime',
  code: 'border border-white/15 text-white/80 hover:border-white/40 hover:bg-white/5 hover:text-white',
  video:
    'border border-white/15 text-white/80 hover:border-red-400/60 hover:bg-red-500/10 hover:text-white',
  ghost:
    'border border-white/15 text-white/80 hover:border-white/40 hover:bg-white/5 hover:text-white'
}
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-magnetic="0.18"
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  {
    variant === 'code' && (
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
      </svg>
    )
  }
  {
    variant === 'video' && (
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" fill="currentColor" aria-hidden="true">
        <path d="M8 5.14v13.72L19 12z" />
      </svg>
    )
  }
  <span>{label}</span>
  {
    variant === 'demo' && (
      <svg
        viewBox="0 0 24 24"
        class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    )
  }
</a>
