<!-- base: el degradado del sitio, anclado al viewport. Antes vivía en el
     contenedor de la página, que mide todo el scroll: el degradado se estiraba
     y se veía azul durante pantallas enteras antes de llegar al tono oscuro. -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-0 h-screen bg-[linear-gradient(40deg,rgb(var(--bg-dark)),rgb(var(--bg-light)))]"
>
</div>

<!-- g5 (opcional interactive): cyan soft. Fijo y a una pantalla de alto, para
     que el halo se quede arriba en vez de crecer con la página. -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed top-[-50lvh] left-0 z-0 block h-[100lvh] w-full bg-[radial-gradient(circle,rgba(var(--clr-cyan)_/_0.6)_0%,rgba(var(--clr-cyan)_/_0)_50%)] opacity-70 md:hidden"
>
</div>

<div class="noise-overlay absolute inset-0 z-0 hidden md:block"></div>

<div class="goo-blur pointer-events-none fixed inset-x-0 top-0 z-0 hidden h-screen opacity-80 md:block">
  <!-- g1: cyan, sube-baja (moveVertical) -->
  <div
    class="mix-blend-[var(--blending)] absolute inset-1/2 hidden h-[var(--circle-size)] w-[var(--circle-size)] -translate-x-1/2 -translate-y-1/2 animate-[var(--animate-vert-30)] bg-[radial-gradient(circle,rgb(var(--clr-cyan))_0%,rgb(var(--clr-cyan))_19%,rgba(var(--clr-cyan)_/_0.45)_24%,rgba(var(--clr-cyan)_/_0)_50%)] md:block"
  >
  </div>

  <!-- g2: lime, círculo reversed -->
  <div
    class="mix-blend-[var(--blending)] absolute inset-1/2 hidden h-[var(--circle-size)] w-[var(--circle-size)] origin-[calc(50%_-_400px)] -translate-x-1/2 -translate-y-1/2 animate-[var(--animate-circle-20R)] bg-[radial-gradient(circle,rgb(var(--clr-lime))_0%,rgb(var(--clr-lime))_19%,rgba(var(--clr-lime)_/_0.45)_24%,rgba(var(--clr-lime)_/_0)_50%)] md:block"
  >
  </div>

  <!-- g3: violeta (complemento lime), círculo grande -->
  <div
    class="mix-blend-[var(--blending)] absolute inset-1/2 top-[calc(50%_+_200px)] left-[calc(50%_-_500px)] hidden h-[var(--circle-size)] w-[var(--circle-size)] origin-[calc(50%_+_400px)] animate-[var(--animate-circle-40)] bg-[radial-gradient(circle,rgb(var(--clr-lime-comp))_0%,rgb(var(--clr-lime-comp))_19%,rgba(var(--clr-lime-comp)_/_0.45)_24%,rgba(var(--clr-lime-comp)_/_0)_50%)] md:block"
  >
  </div>

  <!-- g4: rojo (complemento cyan), horizontal -->
  <div
    class="mix-blend-[var(--blending)] absolute inset-1/2 hidden h-[var(--circle-size)] w-[var(--circle-size)] origin-[calc(50%_-_500px)] -translate-x-1/2 -translate-y-1/2 animate-[var(--animate-horz-40)] bg-[radial-gradient(circle,rgb(var(--clr-cyan-comp))_0%,rgb(var(--clr-cyan-comp))_5%,rgba(var(--clr-cyan-comp)_/_0.45)_10%,rgba(var(--clr-cyan-comp)_/_0)_50%)] md:block"
  >
  </div>
</div>
